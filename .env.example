# Copy to .env next to docker-compose.yml and fill in. Restart the container after changes:
#   docker compose up -d
# See SELF_HOSTING.md for how to get each value.

# --- Required

# The "Web application" OAuth client ID from your Google Cloud project (Google sign-in).
CAULDRON_GOOGLE_CLIENT_ID=
# Your Google account. The owner can always sign in and has no daily limits.
CAULDRON_OWNER_EMAIL=

# --- Who can use it

# invite = only the owner and CAULDRON_ALLOWED_EMAILS can sign in; open = any Google account.
CAULDRON_SIGNUP=invite
# Friends and family who may sign in (comma-separated).
CAULDRON_ALLOWED_EMAILS=
# Accounts that may never sign in, even on an open server (comma-separated).
CAULDRON_BLOCKED_EMAILS=
# Who sees a private recipe library (recipes with source "cookwell"): guests = the owner and
# CAULDRON_ALLOWED_EMAILS; everyone = all users. Only matters if you've loaded such a library.
# (The starter recipes are always shown to everyone.)
CAULDRON_LIBRARY=guests

# --- Importing recipes from videos, web pages, PDFs and photos (optional)

# A Gemini API key from https://aistudio.google.com/apikey (the free tier is enough for a household).
CAULDRON_GEMINI_KEY=
# CAULDRON_GEMINI_MODEL=gemini-3.8-flash
# CAULDRON_GEMINI_FALLBACK=gemini-3.5-flash-lite

# --- Limits for everyone but the owner

CAULDRON_IMPORTS_PER_DAY=20
CAULDRON_UPLOADS_PER_DAY=50
